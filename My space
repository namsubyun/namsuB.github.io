                    <h3 class="text-3xl font-bold tracking-tight text-white">Professional Journey</h3>
                </div>

                <div class="space-y-12">
                    <div class="relative pl-8 border-l border-slate-800">
                        <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-blue-600 ring-4 ring-slate-950"></div>
