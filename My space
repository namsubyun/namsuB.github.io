                <div class="inline-flex flex-col sm:flex-row items-center gap-4">
                    <a href="mailto:your.email@domain.com" class="px-8 py-4 text-base font-semibold text-white bg-blue-600 rounded-xl hover:bg-blue-500 transition-all shadow-lg shadow-blue-600/20">
