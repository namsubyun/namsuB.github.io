                    <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800">
                        <div class="text-4xl font-extrabold text-white mb-2">ROAS Focus</div>
                        <div class="text-sm text-slate-400">Conversion-First Attribution</div>
                    </div>
                    <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800">
