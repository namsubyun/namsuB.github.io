            <div class="max-w-6xl mx-auto text-center">
                <h2 class="text-xs font-semibold text-blue-400 uppercase tracking-widest mb-3">Verified Impact</h2>
                <h3 class="text-3xl font-bold tracking-tight text-white mb-16">Numbers that matter</h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="p-8 rounded-2xl bg-slate-900 border border-slate-800">
